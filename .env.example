# ---------------------------------------------------------------
# REQUIRED. Without these nobody can administer the site.
# ---------------------------------------------------------------
# Signs session cookies. 32+ random characters. Keep it secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If you change it, everyone is signed out.
SECRET_KEY=CHANGE_ME_48_RANDOM_CHARACTERS
# Administrator account, created on first start.
ADMIN_USERNAME=moses
# 10+ characters and must not contain the username, or no admin is created.
ADMIN_PASSWORD=CHANGE_ME_10_OR_MORE_CHARACTERS
# Set true for one deployment to reset the existing administrator password,
# then remove it or set it back to false.
ADMIN_RESET_PASSWORD=false

# ---------------------------------------------------------------
# DATABASE. Pick ONE option.
# ---------------------------------------------------------------
# Option 1: leave every line in this section blank to use local SQLite.
# Option 2 (Neon or any Postgres): paste the full connection string here.
# DATABASE_URL overrides all POSTGRES_* values below.
DATABASE_URL=
# Option 3 (Postgres on your own server): fill in the five lines below.
# Postgres is only used when POSTGRES_USER is not blank.
POSTGRES_USER=
# Use a long random password, never a short number.
POSTGRES_PASSWORD=
POSTGRES_DB=chesslytics_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# WEBSITE AND SECURITY
# ---------------------------------------------------------------
# true lets anyone create an account. false = only you create accounts
# with: python -m app.manage create-user NAME
ALLOW_REGISTRATION=true
# Your domain, e.g. chesslytics.onrender.com. Blank accepts any host.
ALLOWED_HOSTS=
# Leave blank. Only needed if the frontend is on a different domain.
CORS_ORIGINS=
# Set true only when HTTPS is guaranteed at the public URL.
COOKIE_SECURE=false
# Reverse proxies in front of the app. 0 locally. 1 on Render or Caddy.
TRUSTED_PROXY_HOPS=0
# How long a sign-in lasts, in hours.
SESSION_HOURS=24
# true exposes /docs and the API schema. Keep false in production.
ENABLE_DOCS=false

# ---------------------------------------------------------------
# CHESS ENGINE
# ---------------------------------------------------------------
# Leave blank to auto-detect. Debian/Ubuntu: /usr/games/stockfish
# Run `which stockfish` to check. A wrong path causes an error.
STOCKFISH_PATH=
# Default search depth. Higher is slower but more accurate.
STOCKFISH_DEPTH=12
# Seconds per position. If set, it overrides STOCKFISH_DEPTH.
STOCKFISH_TIME=

# ---------------------------------------------------------------
# LIMITS PER USER AND SERVER
# ---------------------------------------------------------------
MAX_UPLOAD_MB=8
MAX_GAMES_PER_UPLOAD=300
MAX_GAMES_PER_USER=1500
MAX_PLIES_PER_GAME=600
# The most depth and seconds a user may request.
MAX_ANALYSIS_DEPTH=18
MAX_ANALYSIS_SECONDS=2
# Analyses running at once. Use 1 on free Render.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=40
MAX_CONCURRENT_GRADING=2
# AI coach reports per user per day.
COACH_DAILY_LIMIT=10
# Default number of puzzles shown in a user's daily practice goal.
DAILY_PUZZLE_GOAL=5
# Maximum number of monthly Chess.com archives read by one import.
IMPORT_MAX_MONTHS=6
MAX_BACKUP_MB=32

# ---------------------------------------------------------------
# AI COACH (optional)
# ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. Blank disables Coach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------
# ADVANCED. Safe to leave as they are.
# ---------------------------------------------------------------
# Run `npm run build` in frontend/ first so this folder exists.
FRONTEND_DIST=frontend/dist
ANALYSIS_DIR=data/analysis
ANALYSIS_CACHE=
VERIFY_CACHE=
PARALLEL_WORKERS=1
VERIFY_WITH=
BOOK_PATH=
PUZZLE_TOLERANCE=5.0

# ---------------------------------------------------------------
# EMAIL (optional)
# ---------------------------------------------------------------
# PUBLIC_URL and MAIL_FROM must be set to enable email. Use either an API
# provider (BREVO_API_KEY or RESEND_API_KEY) or SMTP_HOST.
PUBLIC_URL=
MAIL_FROM=
MAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SMTP2GO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------
# LOGGING AND ERROR TRACKING (optional)
# ---------------------------------------------------------------
LOG_FORMAT=text
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------
# HISTORY AND DATABASE POOLING (advanced)
# ---------------------------------------------------------------
PROFILES_KEPT_PER_USER=5
JOB_RETENTION_DAYS=14
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=15

# Caddy only (docker-compose.yml).
SITE_ADDRESS=:80
