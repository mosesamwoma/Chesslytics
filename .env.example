# Path to the Stockfish binary.
# Debian/Ubuntu: /usr/games/stockfish | Fedora: /usr/bin/stockfish
# Run `which stockfish` to find yours. Leave blank to auto-detect.
# If set to a wrong path the app fails with an error instead of falling back.
STOCKFISH_PATH=/usr/bin/stockfish

# Default engine search limit for the CLI and API when no depth or time is given.
# Higher depth is slower but more accurate. 12 is a good balance.
STOCKFISH_DEPTH=12
# Seconds per position. When set, it takes priority over STOCKFISH_DEPTH.
STOCKFISH_TIME=

# Postgres role name. Replace the placeholder with your own login name
# (run `whoami`) or any existing Postgres role.
POSTGRES_USER=you-name
# Password for that role.
POSTGRES_PASSWORD=1234
# Database name. Create it before first run, or let docker compose create it.
POSTGRES_DB=chesslytics_db
# "auto" uses the docker-compose "postgres" host if reachable, else 127.0.0.1.
# Set a hostname or IP to force one.
POSTGRES_HOST=auto
POSTGRES_PORT=5432
# Full SQLAlchemy URL. When set, it overrides every POSTGRES_* value above.
# Leave blank unless you need it. With nothing configured the app uses SQLite.
DATABASE_URL=

# Where uploaded PGN files are stored.
UPLOAD_DIR=data/uploads
# Where evaluation caches are stored. Delete the cache files to force re-analysis.
ANALYSIS_DIR=data/analysis
# Explicit cache file paths. Leave blank to derive them from ANALYSIS_DIR.
ANALYSIS_CACHE=
VERIFY_CACHE=

# Needed only for the Coach feature. Get a key at https://console.groq.com/keys
# Leave blank to disable Coach; every other feature works without it.
GROQ_API_KEY=
# Groq model used for coaching. If /api/coach returns model_not_found,
# pick another from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Browser origins allowed to call the API. Comma-separate for more than one.
# Use 127.0.0.1, not localhost.
CORS_ORIGINS=http://127.0.0.1:5173
# Built frontend served at / by FastAPI when this folder exists.
# Run `npm run build` in frontend/ first.
FRONTEND_DIST=frontend/dist

# Optional login settings. Leave AUTH_PASSWORD blank to keep the app open.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Long random signing key. Leave blank to derive it from the username/password.
AUTH_SECRET=
# Session lifetime in hours.
AUTH_TOKEN_HOURS=12

# Default number of parallel engine processes (the --workers flag).
# 1 is sequential. Higher is faster on large collections.
PARALLEL_WORKERS=1
# Path to a second engine binary used to double-check flagged mistakes.
# Blank disables verification.
VERIFY_WITH=
# Path to a Polyglot .bin opening book. Blank disables book awareness.
BOOK_PATH=
# Win-percent a training answer may give up and still count as correct.
PUZZLE_TOLERANCE=5.0