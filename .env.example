# Stockfish binary path. Run `which stockfish` to find yours — apt installs
# on Debian/Ubuntu usually put it at /usr/games/stockfish, not /usr/bin.
# Leave blank to auto-detect on PATH.
STOCKFISH_PATH=/usr/bin/stockfish

# Search depth (used unless STOCKFISH_TIME is set, which overrides it and
# searches by seconds instead — faster, less precise).
STOCKFISH_DEPTH=12
STOCKFISH_TIME=

# --- Postgres ---------------------------------------------------------------
# DATABASE_URL is built from the five vars below unless you set DATABASE_URL
# yourself, in which case that value always wins.
#
# To create this database and role locally (skip if you're using
# `docker compose up postgres`, which creates them for you automatically),
# first set POSTGRES_USER below. Your own login name (`whoami`) is the easy
# choice, since Postgres then authenticates you over the local socket without
# a password as well. Then run:
#
#   set -a; . ./.env; set +a
#   sudo -u postgres psql -c "CREATE USER \"$POSTGRES_USER\" WITH PASSWORD '$POSTGRES_PASSWORD';"
#   sudo -u postgres psql -c "CREATE DATABASE \"$POSTGRES_DB\" OWNER \"$POSTGRES_USER\";"
#
# (macOS with `brew install postgresql`, no sudo/postgres system user:
#   createuser "$POSTGRES_USER" --pwprompt
#   createdb "$POSTGRES_DB" --owner="$POSTGRES_USER"
# )
#
# POSTGRES_HOST=auto resolves to the "postgres" docker-compose service when
# reachable, otherwise falls back to 127.0.0.1 — leave it as auto unless
# you're pointing at a remote/managed Postgres instance, in which case put
# its hostname here directly.
#
# `you-name` is a placeholder, not a real role: leave it as-is and every
# connection fails with `role "you-name" does not exist` or, when the server
# asks for a password first, `password authentication failed`.
POSTGRES_USER=you-name
POSTGRES_PASSWORD=1234
POSTGRES_DB=chesslytics_db
POSTGRES_HOST=auto
POSTGRES_PORT=5432
DATABASE_URL=

# Storage locations (created automatically if missing).
UPLOAD_DIR=data/uploads
ANALYSIS_DIR=data/analysis
ANALYSIS_CACHE=
VERIFY_CACHE=

# --- Groq (AI coaching commentary, /api/coach) ------------------------------
# 1. Sign up / log in at https://console.groq.com
# 2. Go to https://console.groq.com/keys -> Create API Key -> copy it below.
# 3. Leave GROQ_API_KEY blank to disable the Coach feature entirely; every
#    other feature works fine without it.
# GROQ_MODEL: which Groq-hosted model answers /api/coach. Groq retires models
# periodically, so if /api/coach returns 502 with `model_not_found`, pick another
# from the live list — https://console.groq.com/docs/models, or confirm yours at
# https://api.groq.com/openai/v1/models with your key.
#   openai/gpt-oss-120b    -> default, best quality for this use case
#   openai/gpt-oss-20b     -> faster and cheaper, lower quality
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Web server / frontend.
# Use the IPv4 loopback (127.0.0.1) rather than "localhost": on dual-stack machines
# localhost can resolve to ::1 while uvicorn only listens on 127.0.0.1.
CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_DIST=frontend/dist

# Optional features — all off by default.
PARALLEL_WORKERS=1     # engine worker processes for --workers
VERIFY_WITH=           # 2nd engine binary, for --verify-with (agree/disputed check)
BOOK_PATH=             # Polyglot .bin, for --book / --exclude-book
PUZZLE_TOLERANCE=5.0   # win% a training answer may lose and still count "correct"