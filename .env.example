# Stockfish binary path. Run `which stockfish` to find yours — apt installs
# on Debian/Ubuntu usually put it at /usr/games/stockfish, not /usr/bin.
# Leave blank to auto-detect on PATH.
STOCKFISH_PATH=/usr/bin/stockfish

# Search depth (used unless STOCKFISH_TIME is set, which overrides it and
# searches by seconds instead — faster, less precise).
STOCKFISH_DEPTH=12
STOCKFISH_TIME=

# Storage locations (created automatically if missing).
DATABASE_URL=sqlite:///./data/Chesslytics.db
UPLOAD_DIR=data/uploads
ANALYSIS_DIR=data/analysis
ANALYSIS_CACHE=
VERIFY_CACHE=

# Web server / frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=frontend/dist

# Optional features — all off by default.
PARALLEL_WORKERS=1     # engine worker processes for --workers
VERIFY_WITH=           # 2nd engine binary, for --verify-with (agree/disputed check)
BOOK_PATH=             # Polyglot .bin, for --book / --exclude-book
PUZZLE_TOLERANCE=5.0   # win% a training answer may lose and still count "correct"